<?xml version="1.0"?>
<package format="3">
  <name>autonomous_ugv_navigation</name>
  <version>1.0.0</version>
  <description>Sensor fusion (EKF), Visual SLAM (RTAB-Map), and Nav2 autonomous navigation stack</description>
  <maintainer email="dev@defence-autonomy.local">Autonomy Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
